#!/usr/bin/env sh
# pm-agent — start a PrivateMind coding agent in an isolated AgentN/ slot.
#
# Why a slot and not `cld --worktree`: privatemind is a *workspace* repo plus
# five separate gitignored sub-repos (app, gateway, app-db, gateway-db, helm).
# A single worktree can't span them, so isolation lives in AgentN/ dirs, each a
# full set of per-repo worktrees (see the workspace CLAUDE.md). This:
#   1. fetches the five canonical repos,
#   2. claims a pristine AgentN slot (or creates the next N),
#   3. resets/creates its five sub-repo worktrees to origin/main (detached),
#   4. launches the chosen agent (claude/opencode/codex — see pm-agent-defs)
#      from the privatemind ROOT so it keeps the global memory, handing it a
#      brief that pins the slot,
#   5. opens a live `diff` window = wstat AgentN (what the agent has touched).
set -u
. "$HOME/dotfiles/bin/pm-agent-defs"

mode=run; TARGET=""; RS=""; AGENT_ID=""; AGENT_EXPLICIT=0; YES=0
while [ $# -gt 0 ]; do
	case "$1" in
	--agent | -a) AGENT_ID="${2:-}"; AGENT_EXPLICIT=1; shift; [ $# -gt 0 ] && shift ;;
	--dry-run | -n) mode=dry; shift ;;
	--slots | -l) mode=slots; shift ;;
	--rename) mode=rename; shift ;;   # sync live display names to their tmux session names
	--prune) mode=prune; shift ;;     # reclaim stale worktrees, slots and merged branches
	--yes | -y) YES=1; shift ;;       # let --prune actually apply its plan
	--reset | -r) mode=reset; shift   # restart a session in place (same slot/name/agent, fresh main)
		case "${1:-}" in -* | "") : ;; *) RS="$1"; shift ;; esac ;;
	*) TARGET="$1"; shift ;;   # a target dir: privatemind → slot flow, else agent-in-repo
	esac
done
[ -n "$AGENT_ID" ] || AGENT_ID="$(agent_last)"
agent_valid "$AGENT_ID" ||
	{ printf 'pm-agent: unknown agent %s (known: %s)\n' "$AGENT_ID" "$PM_AGENTS" >&2; exit 1; }

# Overridable so the destructive paths (--prune, --reset) can be exercised
# against a throwaway workspace instead of the real one.
WS="${PM_WS:-$HOME/forge/privatemind}"
REPOS="${PM_REPOS:-app gateway app-db gateway-db helm}"
TAB="$(printf '\t')"
RECENT_SECS=$((48 * 3600))   # uncommitted work newer than this protects a slot
[ -d "$WS/.git" ] || { printf 'pm-agent: %s is not the workspace checkout\n' "$WS" >&2; exit 1; }

say() { printf '  %s\n' "$*"; }

# Shared launcher: an $AGENT_ID session at $cwd (reads $diff_dir/.agent-brief as
# its first message if present), a diff window watching $diff_dir, targeted by
# id. The session is stamped @pm_agent so --reset relaunches the same agent.
launch_session() {  # cwd  diff_dir  sess  [slot]
	_cwd="$1"; _dd="$2"; _sess="$3"; _slot="${4:-}"
	_cmd="$(agent_cmd "$AGENT_ID" "$_dd/.agent-brief" "$_sess")"
	sid="$(tmux new-session -d -P -F '#{session_id}' -s "$_sess" \
		-n "$(agent_window "$AGENT_ID")" -c "$_cwd" "$_cmd" 2>/dev/null)"
	[ -n "$sid" ] || { printf 'pm-agent: could not start the tmux session\n' >&2; exit 1; }
	tmux set-option -t "$sid" @pm_agent "$AGENT_ID"
	agent_remember "$AGENT_ID"
	[ -n "$_slot" ] && tmux set-option -t "$sid" @pm_slot "$_slot"
	tmux new-window -d -t "$sid" -n diff -c "$_dd" "$HOME/dotfiles/bin/wstat '$_dd'"
	say "launched session $_sess ($AGENT_ID + diff window)"
	if [ -n "${TMUX:-}" ]; then tmux switch-client -t "$sid"
	else tmux attach -t "$sid"; fi
}

# Unique session name from a base (append -2, -3, … on collision).
uniq_sess() {
	_b="$1"; _s="$_b"; _i=2
	while tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -qxF "$_s"; do
		_s="$_b-$_i"; _i=$((_i + 1))
	done
	printf '%s' "$_s"
}

# Fetch, then reset/create a slot's five sub-repo worktrees to a fresh origin/main.
prep_slot() {  # $1 = slot number
	_d="$WS/Agent$1"
	say "fetching origin/main…"
	for r in $REPOS; do git -C "$WS/$r" fetch -q --prune origin 2>/dev/null & done
	wait
	mkdir -p "$_d"
	for r in $REPOS; do
		wt="$_d/$r"
		git -C "$WS/$r" worktree prune -q 2>/dev/null
		if git -C "$wt" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
			git -C "$wt" checkout -q --detach 2>/dev/null   # freeze the branch ref
			git -C "$wt" reset -q --hard origin/main         # move detached HEAD only
			git -C "$wt" clean -qfd                          # drop any stale untracked
		else
			git -C "$WS/$r" worktree add -q --detach "$wt" origin/main ||
				say "! could not create $wt (stray dir?) — skipping"
		fi
	done
	say "sub-repos reset to origin/main"
}

# Write the slot-pinning brief Claude reads as its first message.
write_brief() {  # $1 = slot  $2 = dir
	cat >"$2/.agent-brief" <<EOF
Session bootstrap — do not treat this as a task.

Your isolated worktree slot for this session is Agent$1. Do ALL file work
inside $2/<repo> (app, gateway, app-db, gateway-db, helm) — never the canonical
checkouts at $WS/<repo>. The five sub-repos here are freshly reset to origin/main
on a detached HEAD; branch off before you start, e.g.
  git -C Agent$1/app checkout -b fix/issue-NNN
Acknowledge in one line which slot you're in, then wait for my task.
EOF
}

# --rename: make every live claude session's display name match its tmux session
# name. Told nothing, claude derives one like `privatemind-07`, so tmux, the
# sidebar and claude's own peer listing disagree about what a session is called
# — which makes agent-to-agent messaging guesswork. `/rename` is a local slash
# command (no model call), typed into the pane. Busy panes are skipped: keys
# sent mid-turn queue as that agent's next message instead of running.
if [ "$mode" = rename ]; then
	tmp="$(mktemp)"
	tmux list-panes -a -F "#{pane_id}$TAB#{pane_pid}$TAB#{pane_current_command}$TAB#{session_name}" \
		>"$tmp" 2>/dev/null
	did=0; busy=0; draft=0; fail=0
	while IFS="$TAB" read -r pane ppid cmd sess; do
		[ "$cmd" = claude ] || continue
		cpid="$(claude_pid_of "$ppid")" || continue
		f="$HOME/.claude/sessions/$cpid.json"
		[ -f "$f" ] || continue
		cur="$(jq -r '.name // empty' "$f" 2>/dev/null)"
		[ "$cur" = "$sess" ] && continue
		case "$(jq -r '.status // empty' "$f" 2>/dev/null)" in
		busy) say "busy   $sess (still $cur) — rerun when it's idle"; busy=$((busy + 1)); continue ;;
		esac
		# never type into a pane that already has something in its prompt box:
		# the keys append to it and Enter submits the mixture as that agent's
		# next message — and the draft sitting there may be Andrea's
		# (an empty prompt box is padded with U+00A0, hence the octal strip)
		if [ -n "$(tmux capture-pane -p -t "$pane" 2>/dev/null |
			grep '^❯' | tail -n 1 | sed 's/^❯//' | tr -d '\302\240 \t')" ]; then
			say "draft  $sess (still $cur) — clear its prompt box first"
			draft=$((draft + 1)); continue
		fi
		tmux send-keys -l -t "$pane" "/rename $sess"
		sleep 0.3
		tmux send-keys -t "$pane" Enter
		sleep 1
		# read it back rather than assume: a rename that did not land is a
		# stray message in someone's session, not a cosmetic miss
		if [ "$(jq -r '.name // empty' "$f" 2>/dev/null)" = "$sess" ]; then
			say "named  $cur → $sess"
			did=$((did + 1))
		else
			say "FAILED $sess — check that pane"
			fail=$((fail + 1))
		fi
	done <"$tmp"
	rm -f "$tmp"
	say "$did renamed, $busy busy, $draft with drafts, $fail failed"
	exit 0
fi

# --reset: kill a session and relaunch a fresh one with the SAME name. A slot
# agent keeps its slot and gets a fresh pull off main; a generic agent restarts
# in its own repo (no destructive reset).
if [ "$mode" = reset ]; then
	rs="$RS"; [ -n "$rs" ] || rs="$(tmux display-message -p '#{session_name}' 2>/dev/null)"
	[ -n "$rs" ] || { printf 'pm-agent: no session to reset\n' >&2; exit 1; }
	ragent="$(tmux show-options -t "$rs" -v -q @pm_agent 2>/dev/null)"
	[ "$AGENT_EXPLICIT" = 1 ] || { agent_valid "$ragent" && AGENT_ID="$ragent"; }
	rslot="$(tmux show-options -t "$rs" -v -q @pm_slot 2>/dev/null)"
	if [ -n "$rslot" ] && [ -d "$WS/Agent$rslot" ]; then
		dir="$WS/Agent$rslot"
		say "resetting $rs (Agent$rslot) → fresh main…"
		tmux kill-session -t "$rs" 2>/dev/null
		prep_slot "$rslot"
		write_brief "$rslot" "$dir"
		launch_session "$WS" "$dir" "$rs" "$rslot"
	else
		cwd="$(tmux list-panes -t "$rs" -F '#{pane_current_command} #{pane_current_path}' 2>/dev/null |
			awk -v ags="$PM_AGENTS" 'BEGIN{n=split(ags,a," ")}
				{for(i=1;i<=n;i++) if($1==a[i]) {print $2; exit}}')"
		[ -n "$cwd" ] || cwd="$HOME"
		say "restarting $rs in $cwd…"
		tmux kill-session -t "$rs" 2>/dev/null
		launch_session "$cwd" "$cwd" "$rs"
	fi
	exit 0
fi

# A target that isn't the privatemind workspace → a plain agent in that repo
# (its own cwd/memory, a diff window over it). No slot machinery.
if [ -n "$TARGET" ]; then
	TARGET="$(cd "$TARGET" 2>/dev/null && pwd)" ||
		{ printf 'pm-agent: no such directory: %s\n' "$1" >&2; exit 1; }
fi
if [ -n "$TARGET" ] && [ "$TARGET" != "$WS" ]; then
	repo="$(git -C "$TARGET" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$TARGET")"
	say "agent in $repo"
	launch_session "$repo" "$repo" "$(uniq_sess "$(basename "$repo")")"
	exit 0
fi

# Who holds a slot? At launch we stamp the session with `@pm_slot <N>`, so the
# owner is found by that option — rename-proof (session options survive
# rename-session), and it reports the session's *current* name. A pane parked
# *inside* the slot (a hand-run agent with no stamp) also counts.
slot_holder() {
	tmux list-sessions -F "#{@pm_slot}$TAB#{session_name}" 2>/dev/null |
		awk -F"$TAB" -v n="$1" '$1==n {print $2; f=1; exit} END{exit !f}' && return 0
	tmux list-panes -a -F '#{pane_current_path}' 2>/dev/null |
		grep -qE "^$WS/Agent$1(/|\$)" && printf 'a pane'
}

# Every session that has a stake in a slot, by name — the stamped one and any
# session with a pane sitting inside the slot directory.
slot_sessions() {  # $1 = slot number
	{
		tmux list-sessions -F "#{@pm_slot}$TAB#{session_name}" 2>/dev/null |
			awk -F"$TAB" -v n="$1" '$1==n {print $2}'
		tmux list-panes -a -F "#{pane_current_path}$TAB#{session_name}" 2>/dev/null |
			awk -F"$TAB" -v pfx="$WS/Agent$1" \
				'$1==pfx || index($1, pfx "/")==1 {print $2}'
	} | awk 'NF && !seen[$0]++'
}

# Is any agent still ALIVE in the sessions holding this slot? A dead agent
# leaves its session standing — the `diff` window keeps it alive — so the slot
# stays claimed forever. A SessionEnd hook would not catch this: the cases that
# matter are the crash and the kill, which fire no hook.
slot_orphaned() {  # $1 = slot number
	_h="$(mktemp)"
	slot_sessions "$1" >"$_h"
	[ -s "$_h" ] || { rm -f "$_h"; return 1; }   # nobody holds it at all
	tmux list-panes -a -F "#{session_name}$TAB#{pane_current_command}" 2>/dev/null |
		awk -F"$TAB" -v ags="$PM_AGENTS" -v f="$_h" '
			BEGIN{n=split(ags,a," "); while((getline l < f) > 0) hold[l]=1}
			($1 in hold) {for(i=1;i<=n;i++) if($2==a[i]) {found=1; exit}}
			END{exit !found}' && { rm -f "$_h"; return 1; }
	rm -f "$_h"
	return 0   # held, but nothing in it is an agent any more
}

# Does a slot have any uncommitted/untracked work?
slot_dirty() {
	for r in $REPOS; do
		wt="$WS/Agent$1/$r"; [ -d "$wt" ] || continue
		[ -n "$(git -C "$wt" status --porcelain 2>/dev/null)" ] && return 0
	done
	return 1
}

# Newest mtime (epoch) among a slot's uncommitted/untracked files, or empty.
slot_newest_change() {
	for r in $REPOS; do
		wt="$WS/Agent$1/$r"; [ -d "$wt" ] || continue
		git -C "$wt" status --porcelain 2>/dev/null | sed 's/^...//; s/.* -> //' |
			while IFS= read -r f; do [ -e "$wt/$f" ] && stat -c %Y "$wt/$f" 2>/dev/null; done
	done | sort -rn | head -1
}

# Uncommitted work touched within the last 48h — recent enough to protect.
slot_recent() {
	nw="$(slot_newest_change "$1")"; [ -n "$nw" ] || return 1
	[ "$(( $(date +%s) - nw ))" -lt "$RECENT_SECS" ]
}

# Free (Andrea's rule): no tmux session holds it. Uncommitted work blocks reuse
# only while it's fresh (< 48h); uncommitted work idle longer than that is fair
# game — a reused slot resets it (bad hygiene = lost work). Committed branches
# always survive (reuse only detaches, leaving the ref intact).
slot_free() {
	[ -d "$WS/Agent$1" ] || return 1
	[ -n "$(slot_holder "$1")" ] && return 1
	slot_recent "$1" && return 1
	return 0
}

max=0
for d in "$WS"/Agent[0-9]*; do
	[ -d "$d" ] || continue
	n="${d##*/Agent}"; case "$n" in *[!0-9]*) continue;; esac
	[ "$n" -gt "$max" ] && max="$n"
done

# An ad-hoc worktree is fair game on the same 48h rule the slots use: clean, or
# untouched long enough that leaving it dirty was a choice. Commits are never at
# risk — removing a worktree leaves its branch ref behind.
wt_stale() {  # $1 = worktree path
	[ -n "$(git -C "$1" status --porcelain 2>/dev/null)" ] || return 0
	_nw="$(git -C "$1" status --porcelain 2>/dev/null | sed 's/^...//; s/.* -> //' |
		while IFS= read -r f; do [ -e "$1/$f" ] && stat -c %Y "$1/$f" 2>/dev/null; done |
		sort -rn | head -1)"
	[ -n "$_nw" ] || return 0
	[ "$(( $(date +%s) - _nw ))" -ge "$RECENT_SECS" ]
}

# --prune: reclaim what finished sessions leave behind — the ad-hoc worktrees
# they cut beside the canonical five, free slots still holding stale edits, and
# local branches git itself says are already merged into origin/main (their
# commits are in main, so the ref is the only thing dropped). Slots a session
# holds are never touched. Prints the plan and changes NOTHING without --yes.
if [ "$mode" = prune ]; then
	say "fetching origin/main…"
	for r in $REPOS; do git -C "$WS/$r" fetch -q --prune origin 2>/dev/null & done
	wait
	plan="$(mktemp)"; co="$(mktemp)"

	n=1
	while [ "$n" -le "$max" ]; do
		if slot_free "$n"; then
			for r in $REPOS; do
				git -C "$WS/$r" worktree list --porcelain 2>/dev/null |
					awk '/^worktree /{print $2}' |
					grep -E "^$WS/Agent$n/" | grep -vxF "$WS/Agent$n/$r" >"$co"
				while IFS= read -r wt; do
					[ -n "$wt" ] || continue
					wt_stale "$wt" && printf 'worktree%s%s%s%s\n' "$TAB" "$r" "$TAB" "$wt" >>"$plan"
				done <"$co"
			done
			slot_dirty "$n" && printf 'reset%s%s\n' "$TAB" "$n" >>"$plan"
		elif slot_orphaned "$n"; then
			# the agent is gone but its session stands, holding the slot.
			# Kill only the session; leave the worktrees to reuse, which
			# applies the 48h guard to whatever it left behind.
			slot_sessions "$n" | while IFS= read -r os; do
				printf 'orphan%s%s%s%s\n' "$TAB" "$n" "$TAB" "$os"
			done >>"$plan"
		fi
		n=$((n + 1))
	done

	# a branch checked out in some worktree is off limits; git -d refuses it too,
	# but excluding it here keeps the plan honest about what will actually go
	for r in $REPOS; do
		git -C "$WS/$r" worktree list --porcelain 2>/dev/null |
			awk '/^branch /{sub("refs/heads/","",$2); print $2}' | sort -u >"$co"
		git -C "$WS/$r" branch --merged origin/main --format '%(refname:short)' 2>/dev/null |
			grep -vxE 'main|master' | grep -vxFf "$co" |
			sed "s|^|branch$TAB$r$TAB|" >>"$plan"
	done
	rm -f "$co"

	[ -s "$plan" ] || { say "nothing to prune"; rm -f "$plan"; exit 0; }
	awk -F"$TAB" -v OFS=' ' '
		$1=="worktree" { printf "  drop worktree  %s\n", $3 }
		$1=="reset"    { printf "  reset slot     Agent%s (stale uncommitted)\n", $2 }
		$1=="orphan"   { printf "  end session    %s — holds Agent%s with no agent left\n", $3, $2 }
		$1=="branch"   { b[$2]++ }
		END { for (r in b) printf "  merged branch  %s: %d\n", r, b[r] }' "$plan"
	if [ "$YES" != 1 ]; then
		say ""
		say "nothing changed — rerun as: pm-agent --prune --yes"
		rm -f "$plan"; exit 0
	fi

	say ""
	kept=0
	while IFS="$TAB" read -r kind a b; do
		case "$kind" in
		worktree)
			if git -C "$WS/$a" worktree remove --force "$b" 2>/dev/null
			then say "removed $b"
			else say "! could not remove $b"; kept=$((kept + 1)); fi ;;
		reset) prep_slot "$a" ;;
		orphan)
			tmux kill-session -t "$b" 2>/dev/null &&
				say "ended $b (Agent$a released)" ||
				{ say "! could not end $b"; kept=$((kept + 1)); } ;;
		branch)
			# -d measures against the branch's UPSTREAM, which for a renamed or
			# re-targeted PR is a different branch entirely — so it refuses refs
			# that are demonstrably in origin/main. Re-assert the guarantee we
			# actually rely on, and only then force. The commits still live in
			# main either way; what goes is the label.
			if git -C "$WS/$a" branch -d "$b" >/dev/null 2>&1; then
				:
			elif git -C "$WS/$a" merge-base --is-ancestor "$b" origin/main 2>/dev/null &&
				git -C "$WS/$a" branch -D "$b" >/dev/null 2>&1; then
				:
			else
				say "! kept $a/$b (not an ancestor of origin/main)"
				kept=$((kept + 1))
			fi ;;
		esac
	done <"$plan"
	say "pruned$( [ "$kept" -gt 0 ] && printf ', %s kept back' "$kept" )"
	rm -f "$plan"
	exit 0
fi

# --slots: show occupancy for every slot, then exit. This is the tracker.
if [ "$mode" = slots ]; then
	printf '  PrivateMind agent slots (%s):\n\n' "$WS"
	n=1
	while [ "$n" -le "$max" ]; do
		h="$(slot_holder "$n")"
		if [ -n "$h" ] && slot_orphaned "$n"; then
			st="orphan · $h has no agent left (prefix q, or --prune)"
		elif [ -n "$h" ]; then st="busy   · held by $h"
		elif slot_recent "$n"; then st="in use · uncommitted <48h (won't reuse)"
		elif slot_dirty "$n"; then st="FREE   · stale uncommitted >48h (resets on reuse)"
		else st="FREE"; fi
		printf '  Agent%-3s %s\n' "$n" "$st"
		n=$((n + 1))
	done
	printf '\n  next new agent → Agent%s\n' "$( \
		n=1; while [ "$n" -le "$max" ]; do slot_free "$n" && break; n=$((n + 1)); done; \
		[ "$n" -le "$max" ] && echo "$n (reused)" || echo "$((max + 1))")"
	exit 0
fi

slot=""
n=1
while [ "$n" -le "$max" ]; do
	if slot_free "$n"; then slot="$n"; break; fi
	n=$((n + 1))
done
[ -n "$slot" ] || slot=$((max + 1))
dir="$WS/Agent$slot"
say "slot → Agent$slot"
[ "$mode" = dry ] && { say "(dry run — no worktrees created, no agent launched)"; exit 0; }

prep_slot "$slot"
sess="$(uniq_sess "privatemind-a$slot")"
write_brief "$slot" "$dir"

# Claude launches from the workspace ROOT (keeps the global memory); the brief
# pins the slot. The session is stamped with @pm_slot so ownership survives a
# rename. cwd = $WS (memory), diff window watches the slot dir.
launch_session "$WS" "$dir" "$sess" "$slot"
