#!/usr/bin/env sh
# pm-agent-pick — fuzzy-pick where to open an agent, then hand off to pm-agent.
# Runs in a tmux popup. PrivateMind is pinned first (→ AgentN slot); any other
# directory → a plain agent in that repo. ctrl-f finds any dir under $HOME.
#
# Enter launches the agent you used last (recorded in pm-agent-defs' state), so
# the common case costs no extra keystroke; ^y/^o/^x pick a different one and
# that choice becomes the new default.
set -u
. "$HOME/dotfiles/tmux/fzf-theme.sh"
. "$HOME/dotfiles/bin/pm-agent-defs"
PM="$HOME/forge/privatemind"
AGENT="$HOME/dotfiles/bin/pm-agent"
FD="$(command -v fdfind 2>/dev/null || command -v fd 2>/dev/null || echo find)"

last="$(agent_last)"

list() {
	printf '%s\n' "$PM"
	command -v zoxide >/dev/null 2>&1 && zoxide query -l 2>/dev/null
}

out="$(list | awk 'NF && !seen[$0]++' | sed "s|^$HOME/|~/|" | fzf \
	--expect=ctrl-y,ctrl-o,ctrl-x \
	--border-label " 󰚩  new agent · $(agent_window "$last") " \
	--prompt '  where › ' \
	--header "privatemind → its own AgentN slot   ·   any repo → an agent there   ·   ^f find
enter → $last (last used)   ·   ^y claude   ^o opencode   ^x codex" \
	--preview 'p=$(echo {} | sed "s|^~/|'"$HOME"'/|"); git -C "$p" -c color.ui=always status -sb 2>/dev/null || ls -la "$p" 2>/dev/null | head -40' \
	--preview-window 'right,56%,border-rounded' \
	--bind "ctrl-f:change-prompt(  find › )+reload($FD -H -t d -d 4 . $HOME 2>/dev/null | sed 's|^$HOME/|~/|')")"

key="$(printf '%s\n' "$out" | sed -n 1p)"
sel="$(printf '%s\n' "$out" | sed -n 2p)"
[ -n "$sel" ] || exit 0

# the chosen agent is recorded by pm-agent on a successful launch
case "$key" in
ctrl-y) agent=claude ;;
ctrl-o) agent=opencode ;;
ctrl-x) agent=codex ;;
*) agent="$last" ;;
esac

exec "$AGENT" --agent "$agent" "$(printf '%s' "$sel" | sed "s|^~/|$HOME/|")"
