#!/usr/bin/env sh
# agent [dir] — spin up a Claude agent in a fresh git worktree of the repo at
# `dir` (default: the current directory), in its own tmux session. Each agent
# gets an isolated worktree, so diffs stay clean and agents never collide, and
# Claude's --worktree keeps the repo's memory. General: works in any git repo.
set -eu

dir="${1:-$PWD}"
case "$dir" in "~") dir="$HOME";; "~/"*) dir="$HOME/${dir#\~/}";; esac
dir="$(cd "$dir" 2>/dev/null && pwd)" ||
	{ printf 'agent: no such directory: %s\n' "${1:-$PWD}" >&2; exit 1; }
repo="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" ||
	{ printf 'agent: not inside a git repo: %s\n' "$dir" >&2; exit 1; }

base=$(basename "$repo"); name=$base; i=2
while tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -qxF "$name"; do
	name="$base-$i"; i=$((i + 1))
done

# cld is 'claude --dangerously-skip-permissions'; -w makes the worktree.
tmux new-session -d -s "$name" -c "$repo" \
	'claude --dangerously-skip-permissions --worktree'

if [ -n "${TMUX:-}" ]; then tmux switch-client -t "$name"
else tmux attach -t "$name"; fi
