#!/usr/bin/env sh
# pm-agent-defs — the agent registry. Sourced by pm-agent, pm-agent-pick and
# tmux/claude-panes.sh so all three agree on how each agent is named, launched
# and resumed. Add a new agent here and the picker, launcher, reset and
# resurrection all pick it up.
#
# Every agent must support an initial prompt (we hand it the slot brief) and
# some form of resume (used after a tmux restart).

PM_AGENTS="claude opencode codex"
PM_AGENT_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/pm-agent"

# Single-quote a string for embedding in a shell command.
shq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

agent_valid() {
	for _a in $PM_AGENTS; do [ "$1" = "$_a" ] && return 0; done
	return 1
}

# tmux window name for an agent's own pane.
agent_window() {
	case "$1" in
	claude) printf 'Cyan' ;;
	*) printf '%s' "$1" ;;
	esac
}

# The command tmux runs to START an agent. $2 = brief file; if it exists its
# contents become the agent's first message. $3 = display name — claude shows it
# in the prompt box and in peer listings (`claude --name`), so tmux, the sidebar
# and cross-agent messaging all call a session the same thing. opencode and
# codex have no equivalent flag and keep their own derived names.
agent_cmd() {
	_b="${2:-}"; _n="${3:-}"
	[ -n "$_b" ] && [ -f "$_b" ] || _b=""
	case "$1" in
	claude)
		_c='claude --dangerously-skip-permissions'
		[ -n "$_n" ] && _c="$_c --name $(shq "$_n")" ;;
	codex)    _c='codex --dangerously-bypass-approvals-and-sandbox' ;;
	opencode) _c='opencode' ;;
	*) return 1 ;;
	esac
	if [ -n "$_b" ]; then
		case "$1" in
		opencode) _c="$_c --prompt \"\$(cat $(shq "$_b"))\"" ;;
		*)        _c="$_c \"\$(cat $(shq "$_b"))\"" ;;
		esac
	fi
	printf '%s' "$_c"
}

# The command to RESUME an agent after a tmux restart. $2 = session id, only
# claude has a per-pane one; opencode and codex resume their newest session
# instead (opencode's is scoped to the project dir, codex's is global — so two
# codex panes restored at once both land on the same conversation). $4 = display
# name, re-applied because a resumed session would otherwise derive a fresh one.
agent_resume_cmd() {
	_id="${2:-}"; _args="${3:-}"; _n="${4:-}"
	case "$1" in
	claude)
		[ -n "$_id" ] || return 1
		_c="claude $_args"
		[ -n "$_n" ] && _c="$_c --name $(shq "$_n")"
		printf '%s --resume %s' "$_c" "$_id" ;;
	opencode) printf 'opencode --continue' ;;
	codex) printf 'codex --dangerously-bypass-approvals-and-sandbox resume --last' ;;
	*) return 1 ;;
	esac
}

# Last agent Andrea launched — the picker's Enter default.
agent_last() {
	_l="$(cat "$PM_AGENT_STATE/last-agent" 2>/dev/null)"
	agent_valid "$_l" && printf '%s' "$_l" || printf 'claude'
}

agent_remember() {
	agent_valid "$1" || return 1
	mkdir -p "$PM_AGENT_STATE" 2>/dev/null
	printf '%s\n' "$1" >"$PM_AGENT_STATE/last-agent"
}

# Match a pane's running command to an agent id (for save/restore + reset).
agent_of_command() {
	for _a in $PM_AGENTS; do [ "$1" = "$_a" ] && { printf '%s' "$_a"; return 0; }; done
	return 1
}

# The claude PID behind a pane: tmux runs the agent directly when it has no
# brief and via a shell when the brief has to be interpolated, so the pane pid
# is either claude itself or claude's parent. Its session file — the sidebar's
# and the resurrector's source of truth — is keyed by this pid.
agent_pid_of() {  # $1 = pane pid, $2 = agent id
	[ -n "${1:-}" ] && [ -n "${2:-}" ] || return 1
	[ "$(cat "/proc/$1/comm" 2>/dev/null)" = "$2" ] && { printf '%s' "$1"; return 0; }
	_c="$(pgrep -x "$2" -P "$1" 2>/dev/null | head -n 1)"
	[ -n "$_c" ] || return 1
	printf '%s' "$_c"
}

claude_pid_of() { agent_pid_of "${1:-}" claude; }

# Where an agent publishes its own state, keyed by pid. Claude writes its file
# natively; every other agent goes through a producer into the sidebar's state
# dir — the same file shape, which is what lets one reader serve all of them.
# See ~/forge/agent-sidebar/producers/README.md.
agent_state_json() {  # $1 = pane pid, $2 = agent id -> path, or nothing
	_p="$(agent_pid_of "${1:-}" "${2:-}")" || return 1
	case "$2" in
	claude) _f="$HOME/.claude/sessions/$_p.json" ;;
	*) _f="${XDG_STATE_HOME:-$HOME/.local/state}/agent-sidebar/agents/$_p.json" ;;
	esac
	[ -f "$_f" ] || return 1
	printf '%s' "$_f"
}
