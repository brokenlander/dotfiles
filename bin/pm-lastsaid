#!/usr/bin/env python3
"""pm-lastsaid AGENT PID CWD — the last thing an agent said, read off disk.

Free by construction: every agent streams its conversation somewhere local, so
anything already answered is already written down. Nothing is sent, no turn is
spent, and nothing renders in the agent's pane. Only a question whose answer
does not exist yet has to cost a turn.

One adapter per provider, because each keeps its transcript in its own shape:

  claude    ~/.claude/projects/<slug>/<sessionId>.jsonl   (JSONL)
  codex     ~/.codex/sessions/YYYY/MM/DD/rollout-*.jsonl  (JSONL)
  opencode  ~/.local/share/opencode/opencode.db           (SQLite)

Only claude ties a transcript to a pid. For the other two the newest session
for that working directory is the best available match — the same fidelity
caveat that already applies to resuming them after a tmux restart.

Local-only: a transcript holds everything that agent saw, which is why they are
never synced anywhere.
"""
import json
import os
import sys
from pathlib import Path

HOME = Path(os.environ.get("HOME", "~")).expanduser()
TAIL = 400_000  # these run to megabytes; one line from the end is all we want


def _clean(text):
    return " ".join((text or "").split())


def _tail_lines(path):
    with open(path, "rb") as fh:
        fh.seek(0, os.SEEK_END)
        fh.seek(max(0, fh.tell() - TAIL))
        return fh.read().decode("utf-8", "replace").splitlines()


def claude(pid, cwd):
    meta = HOME / ".claude" / "sessions" / f"{pid}.json"
    if not meta.exists():
        return ""
    sid = json.loads(meta.read_text()).get("sessionId")
    if not sid:
        return ""
    for proj in (HOME / ".claude" / "projects").glob("*/"):
        path = proj / f"{sid}.jsonl"
        if not path.exists():
            continue
        last = ""
        for line in _tail_lines(path):
            try:
                obj = json.loads(line)
            except ValueError:
                continue
            if obj.get("type") != "assistant":
                continue
            text = " ".join(
                b.get("text", "")
                for b in obj.get("message", {}).get("content", [])
                if isinstance(b, dict) and b.get("type") == "text"
            ).strip()
            if text:
                last = text
        return last
    return ""


def codex(pid, cwd):
    root = HOME / ".codex" / "sessions"
    if not root.is_dir():
        return ""
    best = None
    for path in root.rglob("rollout-*.jsonl"):
        try:
            with open(path, encoding="utf-8", errors="replace") as fh:
                head = json.loads(fh.readline())
        except (OSError, ValueError):
            continue
        if head.get("type") != "session_meta":
            continue
        if cwd and head.get("payload", {}).get("cwd") != cwd:
            continue
        stamp = path.stat().st_mtime
        if best is None or stamp > best[0]:
            best = (stamp, path)
    if best is None:
        return ""
    last = ""
    for line in _tail_lines(best[1]):
        try:
            obj = json.loads(line)
        except ValueError:
            continue
        payload = obj.get("payload") or {}
        # codex hands us the answer directly on task_complete
        if payload.get("type") == "task_complete" and payload.get("last_agent_message"):
            last = payload["last_agent_message"]
        elif payload.get("type") == "message" and payload.get("role") == "assistant":
            text = " ".join(
                b.get("text", "")
                for b in payload.get("content", [])
                if isinstance(b, dict) and b.get("text")
            ).strip()
            if text:
                last = text
    return last


def opencode(pid, cwd):
    import sqlite3

    db = HOME / ".local" / "share" / "opencode" / "opencode.db"
    if not db.exists():
        return ""
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    except sqlite3.Error:
        return ""
    with con:
        row = con.execute(
            "SELECT id, title FROM session WHERE directory = ? "
            "ORDER BY time_updated DESC LIMIT 1",
            (cwd,),
        ).fetchone()
        if row is None:
            return ""
        sid, title = row
        # parts carry no role of their own — the message they belong to does,
        # so without the join the newest text part is usually the user's
        for part_data, msg_data in con.execute(
            "SELECT p.data, m.data FROM part p JOIN message m ON m.id = p.message_id "
            "WHERE p.session_id = ? ORDER BY p.time_created DESC LIMIT 60",
            (sid,),
        ):
            try:
                part, msg = json.loads(part_data), json.loads(msg_data)
            except ValueError:
                continue
            if msg.get("role") != "assistant":
                continue
            if part.get("type") == "text" and part.get("text"):
                return _clean(part["text"])
        # nothing said yet: its own summary of the session is the next best thing
        return _clean(title or "")


ADAPTERS = {"claude": claude, "codex": codex, "opencode": opencode}


def main():
    if len(sys.argv) < 3:
        sys.exit("usage: pm-lastsaid AGENT PID [CWD]")
    agent, pid = sys.argv[1], sys.argv[2]
    cwd = sys.argv[3] if len(sys.argv) > 3 else ""
    fn = ADAPTERS.get(agent)
    if fn is None:
        return
    try:
        said = fn(pid, cwd)
    except Exception:
        return  # a roster row is never worth an exception
    if said:
        print(_clean(said)[:2000])


if __name__ == "__main__":
    main()
