#!/bin/bash
# Block AI vendor names and off-repo personal identities in the commit message.
. "$(dirname "$(readlink -f "$0")")/_guard-common.sh"

if grep -iE "$VENDOR_PATTERNS" "$1" >/dev/null 2>&1; then
  guard_die "Commit message names an AI vendor:" "$(grep -inE "$VENDOR_PATTERNS" "$1")"
fi
if grep -iE "$IDENTITY_PATTERNS" "$1" >/dev/null 2>&1; then
  guard_die "Commit message carries a banned identity:" "$(grep -inE "$IDENTITY_PATTERNS" "$1")"
fi
exit 0
